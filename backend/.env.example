# Database
# Required: PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/taskmanagement"

# JWT
# Required: Secret key for signing JWT tokens
# SECURITY: Must be at least 32 characters with mixed case, numbers, and special characters in production
# Generate a strong secret with: openssl rand -base64 32
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-characters-with-uppercase-lowercase-numbers-and-special-chars"

# Token expiration time
# Format: "7d" (7 days), "24h" (24 hours), "30m" (30 minutes), or "3600" (seconds)
JWT_EXPIRES_IN="7d"

# Server Configuration
# Port the server will listen on (1-65535)
PORT="3000"

# Environment mode: development, test, or production
# SECURITY: Set to "production" when deploying to production
NODE_ENV="development"

# CORS Configuration
# Required: Frontend origin that is allowed to make requests to this API
# SECURITY: Change from localhost to your domain in production
CORS_ORIGIN="http://localhost:5173"
