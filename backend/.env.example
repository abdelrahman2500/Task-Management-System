# ============================================================================
# Task Management System - Backend Environment Configuration
# ============================================================================
# 
# IMPORTANT: This file documents all required environment variables.
# NEVER commit the actual .env file with real secrets to version control.
# Only commit .env.example with placeholder values.
#
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection string
# REQUIRED: Yes
# FORMAT: postgresql://[user]:[password]@[host]:[port]/[database]
# EXAMPLE: postgresql://postgres:password@localhost:5432/taskmanagement
# PRODUCTION: Use managed database service (AWS RDS, Azure Database, etc.)
DATABASE_URL="postgresql://postgres:password@localhost:5432/taskmanagement"

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================

# Secret key for signing JWT tokens
# REQUIRED: Yes
# SECURITY: In production, must be:
#   - At least 32 characters long
#   - Include uppercase letters (A-Z)
#   - Include lowercase letters (a-z)
#   - Include numbers (0-9)
#   - Include special characters (!@#$%^&*)
# GENERATION: openssl rand -base64 32
# ROTATION: Change this value to invalidate all issued tokens
JWT_SECRET="replace-with-a-strong-random-secret-at-least-32-characters"

# Token expiration time
# REQUIRED: No (default: "7d")
# FORMAT: Can use "7d" (days), "24h" (hours), "30m" (minutes), or "3600" (seconds)
# PRODUCTION: Consider shorter expiration for enhanced security
JWT_EXPIRES_IN="7d"

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Port the server listens on
# REQUIRED: No (default: 3000)
# RANGE: 1-65535
# PRODUCTION: Use reverse proxy (nginx/Apache) on port 80/443
PORT="3000"

# Environment mode: development, test, or production
# REQUIRED: No (default: "development")
# WARNING: ALWAYS set to "production" in production environments
#   - Enables strict security validation
#   - JSON logging instead of pretty printing
#   - Stack traces not exposed to clients
NODE_ENV="development"

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Frontend origin allowed to make requests to this API
# REQUIRED: Yes
# SECURITY: NEVER use "*" (wildcard) - specify exact domain
# EXAMPLES:
#   - Development: "http://localhost:5173"
#   - Production: "https://app.example.com"
# MULTIPLE: If needed, set to specific domains only
CORS_ORIGIN="http://localhost:5173"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: trace, debug, info, warn, error, fatal
# REQUIRED: No (default: "info" in production, "debug" in development)
# PRODUCTION: "warn" or "info" recommended
LOG_LEVEL="debug"

# ============================================================================
# OPTIONAL VARIABLES
# ============================================================================

# API URL for OpenAPI documentation server selection
# REQUIRED: No (default: http://localhost:3000)
# PRODUCTION: Set to your production domain
API_URL="http://localhost:3000"

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
#
# BEFORE DEPLOYMENT:
#
# 1. Database:
#    - Ensure PostgreSQL is accessible
#    - Database must exist (create if needed)
#    - Run migrations: npx prisma migrate deploy
#
# 2. Environment Variables:
#    - Set NODE_ENV to "production"
#    - Set JWT_SECRET to a strong random value (32+ chars, mixed case, numbers, special chars)
#    - Set CORS_ORIGIN to your actual domain (not localhost)
#    - Verify DATABASE_URL points to production database
#
# 3. Security:
#    - Ensure HTTPS is enabled (required for production)
#    - Configure reverse proxy (nginx/Apache)
#    - Set up firewall rules
#    - Enable rate limiting (already configured in app)
#
# 4. Health Checks:
#    - GET /health - lightweight health check
#    - GET /health/ready - database connectivity check
#
# 5. Graceful Shutdown:
#    - Application handles SIGTERM and SIGINT
#    - Stops accepting new requests
#    - Waits for active requests to complete
#    - Closes database connection
#    - Timeout: 30 seconds (force exit after)
#
# ============================================================================
